[Unit]
Description=Web Hosting Security Agent
Documentation=file:///etc/hosting-agent/README.md
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hosting-agent
ExecStart=/usr/bin/env python3 /opt/hosting-agent/agent.py --daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
# Give the agent time to start cleanly
TimeoutStartSec=30
TimeoutStopSec=30

# NOTE: The agent is a security/monitoring daemon that runs firewall (CSF),
# reads server logs, and manages IP blocking under cPanel/WHM. On cPanel,
# CSF is a Perl script that needs access to /usr/local/csf, /etc/csf, /tmp
# and the cPanel Perl environment. Over-strict sandboxing (ProtectSystem,
# PrivateTmp, NoNewPrivileges, tight CapabilityBoundingSet) breaks csf, so
# we run with a normal root environment.
Environment=PERL5LIB=/usr/local/csf/lib/:/usr/local/csf/lib/arch
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin


[Install]
WantedBy=multi-user.target
